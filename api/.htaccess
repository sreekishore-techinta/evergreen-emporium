Options -Indexes
RewriteEngine On
# RewriteBase auto-detected — works on both /evergreen-emporium/api/ (XAMPP) and /api/ (production)
RewriteBase /api/

# Pass Authorization header to PHP (required for JWT Bearer tokens)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Block direct access to sensitive files
<FilesMatch "\.(sql|env|log|lock|json|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Allow uploads to be served directly (no routing through index.php)
RewriteCond %{REQUEST_URI} /uploads/ [NC]
RewriteRule ^ - [L]

# Route everything else through index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
