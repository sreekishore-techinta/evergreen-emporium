Options -Indexes
RewriteEngine On

# ── Pass Authorization header to PHP ─────────────────────────────
# Required for JWT Bearer tokens — Apache strips this header by default
# in CGI/FastCGI mode. All three methods below cover every Hostinger config.
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ── Block direct web access to sensitive files ────────────────────
<FilesMatch "\.(sql|log|lock|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block .env and .php.bak files
<FilesMatch "^(env\.local\.php|\.env.*|.*\.bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to config directory except through index.php
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^models/ - [F,L]
    RewriteRule ^controllers/ - [F,L]
    RewriteRule ^middleware/ - [F,L]
    RewriteRule ^helpers/ - [F,L]
</IfModule>

# ── Allow uploaded files to be served directly ────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^uploads/ - [L]

# ── Route all other requests through index.php ────────────────────
# This handles all API endpoints: /api/admin/auth/login etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
